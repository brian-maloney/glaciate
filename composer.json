{
	"name": "brian-maloney/glaciate",
	"description": "Publish a WordPress site as static files. Every feature free.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4",
		"phpseclib/phpseclib": "^3.0",
		"woocommerce/action-scheduler": "^4.2"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"Glaciate\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Glaciate\\Tests\\Unit\\": "tests/unit/",
			"Glaciate\\Tests\\Integration\\": "tests/integration/",
			"Glaciate\\Tests\\System\\": "tests/system/",
			"Glaciate\\Tests\\Support\\": "tests/Support/"
		}
	},
	"config": {
		"platform": {
			"php": "7.4.33"
		},
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"prefix-namespaces": [
			"@composer --working-dir=tools/strauss install --no-interaction --no-progress --quiet",
			"@php tools/strauss/strauss.php",
			"@composer dump-autoload --no-scripts",
			"@php -r \"is_file('vendor/composer/autoload_aliases.php') && unlink('vendor/composer/autoload_aliases.php');\""
		],
		"post-install-cmd": [
			"@prefix-namespaces"
		],
		"post-update-cmd": [
			"@prefix-namespaces"
		],
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"test:unit": "phpunit --testsuite unit",
		"test:integration": "phpunit --testsuite integration"
	},
	"extra": {
		"strauss": {
			"target_directory": "vendor",
			"namespace_prefix": "Glaciate\\Vendor\\",
			"classmap_prefix": "Glaciate_Vendor_",
			"constant_prefix": "",
			"packages": [
				"phpseclib/phpseclib"
			],
			"update_call_sites": false,
			"parallel": false
		}
	}
}
